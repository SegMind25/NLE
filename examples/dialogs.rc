#include <windows.h>

#define IDI_APP       1
#define IDM_SETTINGS  100
#define IDM_ABOUT     101
#define IDM_EXIT      102
#define IDD_SETTINGS  200
#define IDD_ABOUT     201
#define IDC_NAME      300
#define IDC_SHOUT     301
#define IDC_RED       302
#define IDC_GREEN     303
#define IDC_BLUE      304
#define IDC_LIST      305
#define IDC_COMBO     306
#define IDC_STATIC    -1

IDI_APP ICON "res/nle.ico"

MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Settings...\tCtrl+S", IDM_SETTINGS
        MENUITEM SEPARATOR
        MENUITEM "E&xit", IDM_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About", IDM_ABOUT
    END
END

MAINACCEL ACCELERATORS
BEGIN
    "S", IDM_SETTINGS, CONTROL, VIRTKEY
END

STRINGTABLE
BEGIN
    IDM_ABOUT "NLE dialogs example"
END

IDD_SETTINGS DIALOGEX 0, 0, 224, 132
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "&Name:", IDC_STATIC, 8, 10, 30, 8
    EDITTEXT        IDC_NAME, 42, 8, 100, 14, ES_AUTOHSCROLL
    AUTOCHECKBOX    "&Shout", IDC_SHOUT, 42, 28, 60, 10
    GROUPBOX        "Colour", IDC_STATIC, 8, 44, 134, 30
    AUTORADIOBUTTON "&Red", IDC_RED, 14, 56, 36, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Green", IDC_GREEN, 54, 56, 40, 10
    AUTORADIOBUTTON "&Blue", IDC_BLUE, 98, 56, 36, 10
    LISTBOX         IDC_LIST, 150, 8, 66, 66, LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    COMBOBOX        IDC_COMBO, 8, 84, 134, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 108, 110, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 166, 110, 50, 14
END

IDD_ABOUT DIALOGEX 0, 0, 170, 62
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 9, "Segoe UI"
BEGIN
    ICON            IDI_APP, IDC_STATIC, 12, 12, 21, 20
    LTEXT           "NLE dialogs example", IDC_STATIC, 44, 14, 110, 8
    LTEXT           "Native Linux Exe", IDC_STATIC, 44, 26, 110, 8
    DEFPUSHBUTTON   "OK", IDOK, 110, 42, 50, 14
END
